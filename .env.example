# ─── Kamerplanter Environment Configuration ───────────────────────
# Copy this file to .env and adjust values before starting:
#   cp .env.example .env
#
# IMPORTANT: Generate secure passwords before deploying!
#   Example:  openssl rand -base64 24

# ── Database (ArangoDB) ───────────────────────────────────────────
ARANGO_ROOT_PASSWORD=changeme
ARANGODB_DATABASE=kamerplanter
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=changeme

# ── Cache / Queue (Valkey/Redis) ──────────────────────────────────
REDIS_URL=redis://valkey:6379/0

# ── TimescaleDB (optional — for sensor time-series) ──────────────
# Enable with: docker-compose --profile timescaledb up
# TIMESCALEDB_ENABLED=false
# TIMESCALEDB_DATABASE=kamerplanter_sensors
# TIMESCALEDB_USERNAME=postgres
# TIMESCALEDB_PASSWORD=changeme

# ── VectorDB (optional — PostgreSQL + pgvector for AI/RAG) ───────
# Enable with: docker-compose --profile vectordb up
# VECTORDB_ENABLED=false
# VECTORDB_DATABASE=kamerplanter_vectors
# VECTORDB_USERNAME=postgres
# VECTORDB_PASSWORD=changeme
# EMBEDDING_SERVICE_URL=http://embedding-service:8080

# ── LLM (optional — for RAG knowledge assistant) ────────────────
# Enable Ollama with: docker-compose --profile ollama up
# Supported providers: anthropic, ollama, openai_compatible
# LLM_PROVIDER=ollama
# LLM_API_KEY=sk-ant-...           # Required for anthropic / openai_compatible
# LLM_API_URL=                      # Required for ollama (e.g. http://ollama:11434) / openai_compatible
# LLM_MODEL=claude-sonnet-4-20250514    # Model name for the chosen provider
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.3

# ── HuggingFace (optional — faster model downloads) ──────────────
# Free token from https://huggingface.co/settings/tokens (read access)
# HF_TOKEN=hf_...

# ── Plant identification (REQ-029, optional) ─────────────────────
# Phase 1 uses Pl@ntNet (free tier, <=500/day). Without a key the feature
# is disabled and the app stays fully functional. Get a key at
# https://my.plantnet.org → Account → API key.
# PLANTNET_API_KEY=
# IDENTIFICATION_PRIMARY_ADAPTER=plantnet

# ── mDNS / Zeroconf Discovery (LAN auto-discovery) ──────────────
# Announces _kamerplanter._tcp.local. so Home Assistant finds the backend.
# Disable in Kubernetes/Cloud — mDNS is LAN-only (Layer 2).
# MDNS_ENABLED=true
# INSTANCE_ID=                       # Auto-generated if empty (kp-<uuid>)

# ── Application ───────────────────────────────────────────────────
DEBUG=false
REQUIRE_EMAIL_VERIFICATION=false
CORS_ORIGINS=["http://localhost:8080"]

# ── Web Push / VAPID (Browser Push notification channel) ──────────
# Required only for the "Browser Push" (PWA) notification channel. When both
# keys are empty the channel registers as "Nicht konfiguriert" and the app
# stays fully functional. Generate a keypair once with:
#   npx web-push generate-vapid-keys        # prints base64url public + private
# (pywebpush also accepts a PEM private key). Set the public key as the browser
# applicationServerKey; keep the private key server-side only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=ops@example.com

# ── Error tracking (#777, optional) ───────────────────────────────
# Sentry-protocol error tracker (GlitchTip is the reference profile, but any
# compatible backend works — switching is a DSN change, never a code change).
#
# With SENTRY_DSN empty NOTHING happens: the Python SDK is never initialised and
# the frontend never even fetches its SDK chunk. That is the default for local
# checkouts, the test suite, and CI.
#
# SENTRY_ENVIRONMENT must come from the closed vocabulary so alert rules match:
#   development | e2e | staging | production
# SENTRY_RELEASE should be the image tag or commit SHA — without it, regression
# detection and "which deploy introduced this" attribution are impossible.
# SENTRY_SAMPLE_RATE is a deliberate decision, not an accident; 1.0 is the
# documented default for this traffic level.
# SENTRY_DSN=https://<public-key>@glitchtip.example.org/1
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_SAMPLE_RATE=1.0
