# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Frontend
node_modules/

# Build artifacts
dist/
build/

# Environment
.env
.env.local
.envrc

# Test reports (generated)
test-reports/e2e/
test-reports/rag-eval/
coverage/
.coverage
.coverage.*

# Helm
*.tgz
helm/kamerplanter/charts/

# Skaffold
.skaffold/

# Claude Code runtime state
.claude/scheduled_tasks.lock
# Harness-managed isolation worktrees — never commit these, and never run long
# work from here (no resumable transcript). Use `task worktree:add` instead.
.claude/worktrees/

# Worktree-local resume artifacts: crash-recovery plans (.resume/<slug>/plan.md)
# and resumable-skill state (.resume/pull-request-*/). Per
# spec/project/parallel-working-copies/ these are working artifacts that must
# never reach the default branch. A developer MAY still checkpoint one into git
# during work via `git add -f`; the guard-resume-files CI hook then forces the
# strip before the PR merges. See scripts/guard_resume_files.sh.
.resume/

# MkDocs build output
site/

# TypeScript build info
*.tsbuildinfo

# RAG eval results (legacy location — now in test-reports/rag-eval/)
test-reports/rag-eval/eval_results.json

# Pre-downloaded ONNX models (large binaries)
docker/embedding-service/models/

# Generated by scripts/docs/gen_catalog.py — do not commit
/docs/de/skills/
/docs/de/agents/
/docs/de/tags.md
/docs/en/skills/
/docs/en/agents/
/docs/en/tags.md

# Generated by scripts/docs/gen_fact_tables.py — do not commit
/docs/_generated/
.tool-versions

# Browser MCP debug artifacts (screenshots, a11y snapshots)
.playwright-mcp/
.venv-docs/

# Vale — style packages fetched by `vale sync` (keep repo-local vocab only)
.github/styles/*
!.github/styles/config/
.github/styles/config/vocabularies/*
!.github/styles/config/vocabularies/kamerplanter/

# KAMI image-render pipeline — generated PNGs + per-run state (scripts/kami/render.py)
.render/

# Generated OpenAPI document — build/release artifact, never checked in
# (regenerate on demand with `task openapi:export`)
src/backend/openapi.json
