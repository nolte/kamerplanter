{
  extends: [
    'github>nolte/gh-plumbing//renovate-configs/common#v2.2.0',
    'helpers:pinGitHubActionDigests',
  ],
  mode: 'full',
  separateMajorMinor: true,
  separateMinorPatch: false,
  // ── Helm dev values also carry a third-party pin (#1027) ─────────────────────
  // The built-in `helm-values` manager only matches `values.yaml` by default, so
  // `helm/kamerplanter/values-dev*.yaml` — which pin `timescale/timescaledb` for
  // the dev TimescaleDB StatefulSet — aged unattended: no version/CVE bumps ever
  // reached them (the defect #1027 records; found while doing #1024). Renovate
  // merges a manager's `managerFilePatterns` with its built-in default rather
  // than replacing it, so this ADDS the dev overrides to scope while `values.yaml`
  // stays covered by the default pattern. Widening also exposes the registry-less local Skaffold
  // image names (`kamerplanter-*`) those files reference, which Renovate cannot
  // resolve; the packageRule below disables them by pattern.
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)values-dev[^/]*\\.ya?ml$/',
    ],
  },
  // ── The E2E suite's own dependencies, unobserved behind an inherited rule ──
  // `config:recommended` (through the gh-plumbing commons) pulls in
  // `:ignoreModulesAndTests`, whose `ignorePaths` includes `**/tests/**`. That
  // rule is written for a repository whose `tests/` holds fixtures and sample
  // projects; here it also swallows `tests/e2e/`, which is a real, shipped
  // artefact — `tests/e2e/requirements.txt` (selenium, pytest-bdd, pytest-xdist),
  // `tests/e2e/package.json` (axe-core) and `tests/e2e/Dockerfile` (the image the
  // nightly matrix and the `E2E smoke` lane build). None of them was Renovate-
  // managed: measured with `task renovate:dry-run` on 2026-09-17 before this
  // block, `pip_requirements` extracted 2 files and `npm` 1, and `tests/e2e` was
  // in neither (#1464).
  //
  // `ignorePaths` is REPLACED, not merged, so the inherited list is restated in
  // full minus the one pattern. The narrower alternative — keeping `**/tests/**`
  // and adding `tests/e2e/**` back — does not exist: Renovate has no un-ignore
  // syntax, an entry can only be added to the ignore list.
  //
  // WHAT THIS ADMITS BESIDES `tests/e2e`, measured rather than reasoned about:
  // no other `tests/` directory in this checkout carries a manifest any manager
  // reads (`src/backend/tests/`, `src/frontend/src/**/__tests__/` and the E2E
  // fixtures hold Python and TypeScript sources only). `**/test/**` and
  // `**/__tests__/**` are kept because nothing here needs them lifted, so the
  // change stays the smallest one that reaches the files it is about.
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/__tests__/**',
    '**/test/**',
    '**/__fixtures__/**',
  ],
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      pinDigests: true,
    },
    // ── Registry-less local Skaffold images in the dev values (#1027) ─────────
    // Widening `helm-values` to `values-dev*.yaml` (manager block above) also
    // exposes the local build artefacts those files reference —
    // `kamerplanter-knowledge`, `kamerplanter-knowledge-service`,
    // `kamerplanter-reranker-service`, `kamerplanter-embedding-service`,
    // `kamerplanter-vectordb`, `kamerplanter-inference-service`. Skaffold builds
    // these in-cluster; they have NO registry, so Renovate cannot look them up
    // and would only emit resolution failures. Disable them by PATTERN, not by
    // an enumerated list, so a new `kamerplanter-*` dev service is excluded
    // automatically instead of silently starting to fail on the next scan.
    //
    // Anchored on the bare name on purpose: the first-party images live under
    // `ghcr.io/nolte/kamerplanter-*` in the base values.yaml and start with the
    // registry host, so they are NOT matched by `^kamerplanter-`. They are not
    // managed by Renovate at all any more: on develop they reference `latest`
    // and only the release job pins them to `<version>@sha256:…`
    // (scripts/ci/pin_chart_image_digests.sh) — the develop-side digest
    // write-back this file used to carry (#987/#1024) fed a chart that no
    // deployment consumed and rebased itself into a loop on every publish
    // (#1326), so it was removed on 2026-09-10. The one genuine third-party pin
    // in these files, `timescale/timescaledb`, is likewise not matched and is
    // tracked for version/CVE bumps in the cross-manager image group below.
    {
      matchManagers: [
        'helm-values',
      ],
      matchPackageNames: [
        '/^kamerplanter-/',
      ],
      enabled: false,
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      groupName: 'github-actions major',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    // ── Python dependency management (NFR-009 §6.1) ──────────────────────────
    // Each Python tree's `pyproject.toml` is the single source of truth and the
    // `uv.lock` beside it the hash-bearing lock. The built-in `pep621` manager
    // owns both: it bumps the range in pyproject.toml when a release leaves it
    // and runs `uv lock --upgrade-package` in the SAME pull request, so source
    // and lock always move together. Renovate pins the uv it runs to
    // `[tool.uv].required-version` from that file (the pep621 uv processor
    // reads it when no `constraints.uv` is set), which is also what the
    // Dockerfile and CI install — one floor, three consumers.
    //
    // Until 2026-09-10 this was the `pip-compile` manager over two pip-tools
    // locks. That manager rejects lock-header options outside its allowlist
    // (`--no-strip-extras`, `--no-build-isolation` — both needed here, #906,
    // #1303), so from 2026-08-02 it silently extracted nothing, the dashboard
    // showed `WARN: pip-compile error`, and the `poetry` manager picked the
    // pyproject up instead and opened source-only pull requests that left the
    // locks stale (#1371). Poetry 2 reads PEP 621 `[project]` tables, so that
    // manager is disabled and exactly one manager reads the file.
    //
    // Disabled repository-wide, not per directory: since #1374 every Python
    // tree here — the backend and the four side services — is a PEP 621 project
    // with a uv.lock beside it, so there is no file left that `poetry` may
    // legitimately own. Scoping the rule to a path is what let the side
    // services keep a poetry-managed pyproject without a lock for months; a
    // repository-wide `enabled: false` means a newly added pyproject cannot
    // quietly acquire a second manager either.
    {
      matchManagers: [
        'poetry',
      ],
      enabled: false,
    },
    // The uv toolchain is referenced in three KINDS of place, 23 times in total
    // as of #1464 — RE-COUNTED, not adjusted, and the previous number was
    // already wrong before this change: it said "17 … as of #1383" with "seven
    // workflow steps", while develop @ 9f2d9552a carried TEN of those steps and
    // 20 references in all. A count in a comment ages silently; the guard named
    // below is what does not.
    //
    // Measured with the commands the count is made of:
    //   grep -rn 'required-version = "==' --include=pyproject.toml .   -> 7
    //   grep -rln ghcr.io/astral-sh/uv --include=Dockerfile .          -> 5
    //   grep -rc 'astral-sh/setup-uv@' .github/workflows/*.y*ml        -> 11
    //
    //   * `[tool.uv].required-version` in seven pyproject.toml — the backend,
    //     the four side services (#1374) and the two shared libraries (#1464).
    //     This is what Renovate itself relocks with (its pep621 uv processor
    //     falls back to it when `constraints.uv` is unset), read via the custom
    //     regex manager below — whose file list is held to exactly these seven
    //     by src/backend/tests/unit/guards/test_uv_pin_manager_covers_every_pin.py.
    //   * `ghcr.io/astral-sh/uv` in five Dockerfiles (dockerfile manager). The
    //     two libraries ship no image, so they contribute no entry here.
    //   * `astral-sh/setup-uv` in eleven workflow steps (github-actions manager).
    //
    // They are only meaningful together: a relock by a newer uv than the readers
    // is the #1296 class. One pull request moves all of them.
    //
    // THIS GROUP IS DELIBERATELY NOT MERGED INTO `application dependencies`
    // below (#1550). uv is not a dependency of any application here — it is the
    // RESOLVER that produces seven lock files, and the evidence for accepting a
    // bump is "every lock relocks identically and every image still builds",
    // not "the test suite is green". The application group is judged on the
    // second kind of evidence, so the two must not share a branch.
    //
    // The ACTION joins this group rather than sitting in the generic
    // `github-actions` one so that both halves of the resolver path are READ
    // TOGETHER — not because either half silently changes the other. What is
    // actually true, and all that is claimed here: with
    // `version-file: src/backend/pyproject.toml` (#1383) the installed uv is
    // decided by `[tool.uv].required-version` ALONE, so an action bump does not
    // move the resolver. The reason to review them in one pull request is that
    // the action is the code that reads, caches and installs that pin, and the
    // pin is what it installs; a reviewer looking at either one in isolation is
    // looking at half of the mechanism that produces five lock files.
    // The generic `github-actions` rule above would otherwise have claimed it;
    // this rule is later in the array and therefore wins on `groupName`.
    //
    // `automerge: false` is explicit for the same reason. The generic
    // `github-actions` rule automerges minor/patch/digest, and everything else in
    // this group changes the RESOLVER that produces five lock files — a change
    // whose blast radius is every Python image here. It gets read before it
    // lands.
    {
      groupName: 'uv toolchain',
      matchDatasources: [
        'pypi',
        'docker',
        'github-tags',
      ],
      matchPackageNames: [
        'uv',
        'ghcr.io/astral-sh/uv',
        'astral-sh/setup-uv',
      ],
      automerge: false,
    },
    // The build backend uv is constrained to for the two sdist-only backend
    // dependencies (`[tool.uv].build-constraint-dependencies`), read by the
    // regex manager below. Grouped so setuptools and wheel move together.
    //
    // Position is load-bearing and UNCHANGED by #1550: this rule sits ABOVE
    // `application dependencies`, so if `pep621` ever extracted a dependency
    // literally named setuptools or wheel from src/backend/pyproject.toml, the
    // later application rule would claim it — exactly as the `python
    // minor/patch` group did before. Only the regex-manager build constraint,
    // which the application rule does not match, stays here.
    {
      groupName: 'python build backend',
      matchDatasources: [
        'pypi',
      ],
      matchFileNames: [
        'src/backend/pyproject.toml',
      ],
      matchPackageNames: [
        'setuptools',
        'wheel',
      ],
    },
    // In-range releases (a minor or patch inside `>=x,<y`, or anywhere above a
    // bare `>=x` floor) never leave the range, so with the default strategy
    // Renovate would propose nothing and the lock would only ever move on a
    // major. `update-lockfile` keeps the pyproject range untouched and moves
    // uv.lock for every release, which is what makes the application group
    // below fire at all for Python — it could not before, and a rule that
    // cannot fire is not a policy.
    //
    // This used to be SEVEN statements: one standalone rule for `src/backend/**`
    // and one `rangeStrategy` carried inside each of the six per-tree group
    // rules (`python inference-service`, `python knowledge-service`,
    // `python embedding-service`, `python reranker-service`,
    // `python kp_vectordb`, `python kp_errortracking`). #1550 dissolved those
    // six groups into one application group; the strategy did NOT dissolve with
    // them — it is restated here once, unscoped, which covers the same seven
    // trees (`pep621` extracts exactly `EXPECTED_PEP621_FILES` in
    // scripts/ci/check_renovate_dashboard.py and nothing else) and additionally
    // covers an eighth tree the day someone adds one. A per-tree file filter is
    // what let a tree be added without the strategy before.
    {
      matchManagers: [
        'pep621',
      ],
      rangeStrategy: 'update-lockfile',
    },
    // ── ONE group for every application dependency (#1550) ───────────────────
    // Direct operator instruction: application dependencies arrive as ONE
    // reviewable bump, whatever the service, whatever the ecosystem.
    //
    // WHAT THIS REPLACED — fourteen groups, most of them one per tree:
    // `python minor/patch`, `python fastapi-stack`, `python major`,
    // `python inference-service`, `python knowledge-service`,
    // `python embedding-service`, `python reranker-service`,
    // `python kp_vectordb`, `python kp_errortracking`, `frontend eslint`,
    // `frontend mui`, `frontend react`, `frontend typescript`,
    // `frontend minor/patch`, plus the dependency half of `e2e test suite`.
    // Most of those carried a COHESION argument — fastapi/starlette/pydantic
    // move together, @mui/* move together, react and its types move together,
    // the E2E suite's selenium/pytest-bdd move together. Every cohesion
    // argument is SUBSUMED, not refuted: a single group ships all of them in
    // the same branch, which is strictly stronger than "these four together,
    // those three together".
    //
    // TWO OF THE FOURTEEN WERE NOT COHESION ARGUMENTS BUT SEPARATION
    // ARGUMENTS, and this group OVERRULES them rather than subsuming them.
    // Saying otherwise would hide the only thing that was actually given up:
    //   * `python embedding-service` / `python reranker-service` et al. existed
    //     so "a bump to the embedding service must not drag the reranker
    //     image's rebuild into the same pull request". It now does.
    //   * `python kp_vectordb` / `python kp_errortracking` existed because
    //     `sync.py` vendors both libraries into the backend and both Python
    //     services, so "a bump lands in several trees at review time and must
    //     not arrive mixed with an unrelated library's". It now arrives mixed.
    // Both are SUSPENDED BY DIRECT OPERATOR INSTRUCTION (#1550), not refuted by
    // a measurement — which is a legitimate reason and a different one. If
    // either bites, the repair is a narrow rule BELOW this one, and this
    // paragraph is what tells the next reader the cost was known.
    //
    // WHAT THE SPLIT COST, measured on 2026-09-19 (#1550): ten `renovate/`
    // branches open at once for one routine week. `required_status_checks.strict`
    // is true, so N bumps cost N full CI cycles; and the inherited
    // `prConcurrentLimit: 10` then became the policy — the CVE-bearing
    // `transformers` v5 bump (#1480) sat "Rate-Limited" because the queue was
    // full, not because any rule held it.
    //
    // MATCHED BY MANAGER, NOT BY PATH, and that is the whole design:
    //   * it reaches every tree at once — src/backend, the four service images,
    //     the two shared libraries, src/frontend, tests/e2e, docs/ and
    //     tools/rag-eval — without an enumerated path list that a new tree can
    //     be added outside of (the failure this file has paid for twice: #1374
    //     and #1464 both added trees that no rule knew about);
    //   * it CANNOT claim a container image. `dockerfile`, `docker-compose`,
    //     `helm-values` and `helmv3` are not in this list, so the base images of
    //     `tests/e2e/Dockerfile` stay with the image group below — the second
    //     assertion of the retired `e2e test suite` block (#1464/#1491), which
    //     used to rest on rule ORDER alone and now rests on the manager filter
    //     as well. MEASURED after this change: `node 22-slim -> 24-slim` in
    //     tests/e2e/Dockerfile still resolves to a third-party image branch, not
    //     to an application branch.
    //
    // WHAT WAS MEASURED, 2026-09-19, `LOG_LEVEL=debug task renovate:dry-run`
    // against this working tree, reading the RESOLVED branch of each pending
    // update rather than arguing from rule order (#1491 is the review that had
    // to correct exactly that mistake). Updates the repository had no candidate
    // for were FORCED in a throw-away state — an exact pin below the current
    // release, or a lowered `version` in uv.lock / package-lock.json, because
    // Renovate resolves pep621 and npm against the LOCKED version and a lowered
    // manifest range alone yields `updates: []` (the #1464 finding, confirmed
    // again here on axe-core). Observed, all of them, in
    // `renovate/application-dependencies`:
    //
    //   pep621   fastapi, structlog        src/backend/pyproject.toml   (forced)
    //   pep621   psycopg, psycopg-pool     inference-, knowledge-service,
    //                                      kp_vectordb                  (real)
    //   npm      @mui/x-*, eslint, knip,
    //            prettier                  src/frontend/package.json    (real)
    //   npm      typescript                src/frontend/package.json    (forced)
    //   npm      axe-core                  tests/e2e/package.json       (forced)
    //   pip_req  selenium, pytest-xdist    tests/e2e/requirements.txt   (forced)
    //   pip_req  mkdocs-redirects          docs/requirements.txt        (forced)
    //   pip_req  httpx                     tools/rag-eval/requirements.txt (forced)
    //
    // The axe-core line retires the "NOT MEASURED" caveat #1464 left behind: it
    // is now an observation, not a reading of rule order.
    //
    // THE jsdom HOLD WAS RE-MEASURED after the consolidation, because it is now
    // the only npm hold left AND the worked example the escape-hatch paragraph
    // above leans on — and it had been read from rule order, which is the
    // distinction #1491 already paid for once. Forced with `jsdom` lowered to
    // 29.0.1 in src/frontend/package-lock.json, so that a 29.x minor AND the 30
    // major were both computed. Observed:
    //   `Filtered out 1 disabled update(s)`, `jsdom` appears exactly once in the
    //   flattened list, no jsdom branch exists, and the surviving
    //   `jsdom minor ^29.0.1` sits in `renovate/application-dependencies`.
    // The hold still holds and the minors still flow, inside the group.
    //
    // STILL NOT MEASURED, and named as such: the two shared libraries'
    // kp_errortracking tree and `src/backend`'s remaining 100-odd dependencies
    // were not individually forced — they are the same manager and the same
    // rule as the entries above, but that is an inference. And the
    // `embedding-service` / `kp_errortracking` trees produced no candidate at
    // all today.
    //
    // MAJORS SPLIT OFF BY THEMSELVES. `separateMajorMinor: true` at the top of
    // this file gives the group two branches without a second rule:
    // `renovate/application-dependencies` and
    // `renovate/major-application-dependencies`. A held major therefore cannot
    // stall the routine stream — MEASURED: the `transformers` major resolves to
    // the second branch while psycopg/psycopg-pool/@mui/eslint/knip/prettier
    // resolve to the first.
    //
    // THE TRADE, stated rather than discovered later: one broken package now
    // blocks the whole group's branch. That is deliberate. The alternative was
    // measured and is worse — a queue that silently drops a CVE fix on the
    // floor. When one member does block the branch, the escape is
    // `matchPackageNames` on a temporary rule BELOW this one (the jsdom hold is
    // the worked example), not a new permanent per-tree group.
    //
    // `automerge: false` IS WRITTEN OUT, not inherited. The commons config this
    // file extends does not automerge these managers today, but nothing here
    // reads that config, and the risk this group concentrates is new: before
    // #1550 it was spread over `frontend minor/patch` and `python minor/patch`,
    // and now ONE branch carries backend runtime, frontend runtime and the E2E
    // suite at once. `uv toolchain` above spells the same flag out for the same
    // reason. Two named requirements land inside this group and neither may
    // depend on an inherited default:
    //   * NFR-009 §3.4 forbids auto-merge for MINOR updates of `react`,
    //     `react-dom`, `fastapi` and `typescript` — all four are in this group
    //     now, where before they sat in `frontend react` / `frontend typescript`
    //     / `python fastapi-stack`;
    //   * the selenium ceiling in tests/e2e/requirements.txt exists because
    //     `pages/_element_proxy.py` reads Selenium internals, and a green E2E
    //     run is exactly what a bump there has to be judged on.
    //
    // WHAT THIS GROUP DOES NOT REACH, and it is not reasoned about but
    // measured. `rangeStrategy` below applies to `pep621` only. The three
    // `pip_requirements` files carry OPEN ranges and have no lock beside them
    // (`selenium>=4.25.0,<5`, `pytest-xdist>=3.5.0`, `mkdocs>=1.6,<2.0`, …), so
    // with the default `replace` strategy an IN-RANGE release proposes nothing:
    // measured 2026-09-19, the baseline run had zero `pip_requirements` updates
    // while the selenium docker IMAGE moved 4.48 -> 4.49 in the same run, and
    // every pip_requirements entry in this change's measurement table had to be
    // forced with an exact pin. Concretely: `selenium` 4.26 -> 4.49 inside
    // `>=4.25.0,<5` never arrives.
    //
    // NOT repaired here with `rangeStrategy: 'bump'`, deliberately. #1509 is the
    // open decision on exactly these three files — lock them, hash-pin them, or
    // record them as out of scope — and its leading candidate gives tests/e2e a
    // `pyproject.toml` + `uv.lock`, which would move that tree under `pep621`
    // and make a `bump` rule added today dead code tomorrow. One decision, one
    // place. What must not happen is the state this comment replaced: a claim
    // that the group "reaches every tree at once" with the limitation nowhere.
    {
      groupName: 'application dependencies',
      matchManagers: [
        'pep621',
        'npm',
        'pip_requirements',
      ],
      automerge: false,
    },
    // ── jsdom held at 29 until Testing Library catches up (#827) ─────────────
    // jsdom 30 reimplemented its CSS engine, and the new `getComputedStyle`
    // return values make `@testing-library/dom`'s `isInaccessible()` classify
    // everything rendered into a MUI portal (Select menus, Autocomplete poppers,
    // dialogs) as inaccessible. Those elements then vanish from every role
    // query: 71 of 361 frontend test files went red on the 29 -> 30 bump (#824).
    //
    // This is an interaction between jsdom 30 and Testing Library, not a defect
    // in our components — the same components pass their E2E coverage in a real
    // browser. But there is nothing to bump *to*: `@testing-library/dom` is at
    // 10.4.1, published 2025-12-13, and that is exactly what is installed; the
    // upstream tracker carries no jsdom-30 issue. Rewriting the affected tests
    // off role queries would weaken them to enable a version bump, which the
    // issue explicitly rules out.
    //
    // So majors are held and minors/patches keep flowing. Revisit when
    // `@testing-library/dom` ships a release naming jsdom 30, then drop this
    // rule and let the bump run — do not simply raise the pin.
    //
    // BELOW the application group since #1550, and it has to be: this is the
    // worked example of the escape hatch that group's comment names. A held
    // package is removed from the branch by a narrower rule further down, never
    // by giving its tree a group of its own again.
    {
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'jsdom',
        '@types/jsdom',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    // Hold TypeScript below 7.0 until typescript-eslint ships a release
    // supporting the native TS 7 compiler. Its peer range is currently
    // "typescript >=4.8.4 <6.1.0", so TS 7 fails `npm ci` (ERESOLVE) and
    // crashes eslint. tsc/vitest already pass under TS 7 (see PR #425).
    // Remove this cap once typescript-eslint declares TS 7 support.
    //
    // The `frontend typescript` group this cap used to hang on is gone (#1550);
    // the cap is not. It carries no `groupName`, so TypeScript stays in the
    // application group above — a later rule without a `groupName` refines the
    // match, it does not reset the group.
    {
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'typescript',
      ],
      allowedVersions: '<7.0.0',
    },
    // ── Third-party images: ONE pull request, whatever the image, whatever
    //    the file (#1359/#1369, widened by #1550) ──────────────────────────────
    // The same image is referenced from docker-compose*.yml (docker-compose
    // manager), helm/kamerplanter/values*.yaml (helm-values), the Dockerfiles
    // (dockerfile) and workflow `env:` values (the regex manager below). Until
    // 2026-09-10 the groups here matched on `matchManagers`, so one upstream
    // release became one pull request PER MANAGER — timescaledb 2.30.0 arrived
    // as #1359 (compose) and #1369 (helm values) — and the two halves could be
    // merged days apart, leaving CI and the dev cluster on different databases.
    // Grouping on package identity alone puts every reference in one branch.
    //
    // #1550 went one step further, but only for HALF the update types. The
    // group name was `{{depName}} image`, i.e. one branch PER IMAGE, and on
    // 2026-09-19 that was five of the sixteen open branches at once
    // (`python-image`, `node-image`, `major-node-image`,
    // `postgres-18-bookworm`, `ollamaollama-image`) — four of them digest-only
    // rebuilds of the SAME upstream release. Those four collapse into one
    // `renovate/third-party-images`. The #1359/#1369 guarantee is not weakened
    // by that, it is subsumed: one upstream release still cannot be split
    // across managers, because the branch is now shared by MORE references,
    // not fewer.
    //
    // MAJORS KEEP THEIR PER-IMAGE NAME, and the conditional below is what does
    // it. The first version of this change let `separateMajorMinor` produce a
    // single `renovate/major-third-party-images`, which would have put a node
    // 22 -> 24, a python 3.14 -> 3.15, a postgres 18 -> 19 and an arangodb 3 ->
    // 4 in ONE branch — four rebuilds of four different stacks, each judged on
    // its own evidence, any one of which blocks the other three. That is the
    // exact coupling the selenium rule below refuses, and the review of #1550
    // caught that this file was arguing both sides one rule apart. There is no
    // routine-stream saving to trade for it either: base-image majors are rare,
    // and on 2026-09-19 there was exactly one (node, from tests/e2e/Dockerfile),
    // so the conditional costs zero branches today — MEASURED, not assumed.
    //
    // Written as a handlebars conditional on ONE rule rather than a second rule
    // with `matchUpdateTypes: ['major']`, because a second rule would have to
    // repeat the package list below — and an enumerated list that exists twice
    // is the drift this very list already cost us once (`postgres` was in no
    // group at all until #1550 measured it).
    //
    // `matchDatasources: ['docker']` is not decoration: the github-actions
    // manager also extracts `python 3.14` (setup-python) and the asdf manager
    // `node`, and without the datasource filter those would be pulled into the
    // image group.
    //
    // Workflow SERVICE containers are in here for the same reason: the
    // github-actions manager extracts `jobs.<id>.services.<id>.image` as an
    // ordinary docker dependency (`depType: service`), so the ArangoDB service
    // of the `Integration tests (ArangoDB)` job in backend-guards.yml lands in the
    // same branch as the compose reference. Verified 2026-09-16 with
    // `renovate --platform=local --dry-run=extract`, because a lane digest that
    // drifted from the compose digest would mean CI and the dev stack measure
    // against different servers (#1432).
    //
    // This rule stays BELOW the application group above. The application group
    // matches by manager and can never claim a docker dependency, so the order
    // is no longer what carries the separation — but the base images of
    // `tests/e2e/Dockerfile` reaching THIS group rather than an application one
    // is the assertion the retired `e2e test suite` block existed for
    // (#1464/#1491, where an earlier edit got the order wrong and the block won
    // nothing it was written for), and it is measured again for #1550.
    //
    // TWO NAMES WERE ADDED TO THE LIST BY #1550, because the list is
    // enumerated and they had fallen outside it — which is the standing
    // weakness of matching images by name rather than by datasource:
    //   * `postgres` (docker/vectordb/Dockerfile) — MEASURED as an ungrouped
    //     branch of its own, `renovate/postgres-18-bookworm`, in the 2026-09-19
    //     baseline run. It is a third-party database base image like the others
    //     and had simply never been listed.
    //   * `busybox` (docker/knowledge/Dockerfile:1, `FROM busybox:1.38.0@…`) —
    //     NOT MEASURED: it has no pending update, so its assignment is read from
    //     rule order, not observed. The first version of this comment sourced it
    //     to docker/vectordb/Dockerfile, which carries `postgres` and no
    //     busybox; the review of #1550 measured the line.
    // Deliberately NOT added: `renovate/renovate` and `ghcr.io/hadolint/hadolint`.
    // Those are TOOL pins, not application images — a floating or stale tool
    // silently changes what a check MEANS (#1177), which is judged on different
    // evidence from "the stack still starts". Also not added: `huggingface_hub`
    // and `optimum.onnxruntime`, which the dockerfile manager extracts as docker
    // dependencies from the side-service images although they are PyPI packages;
    // grouping a mis-extraction would only make it harder to see.
    //
    // No automerge. These are the databases the tests run against and the
    // browser the E2E suite drives; a green run is necessary but the merge
    // stays a decision.
    {
      groupName: '{{#if (equals updateType "major")}}{{depName}} image{{else}}third-party images{{/if}}',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'timescale/timescaledb',
        'arangodb',
        'valkey/valkey',
        'ollama/ollama',
        'nginxinc/nginx-unprivileged',
        'python',
        'node',
        'postgres',
        'busybox',
      ],
    },
    // selenium/hub and selenium/node-chrome version independently (4.x vs the
    // Chrome major) but must match each other at runtime, so a hub minor and a
    // node "major" belong in the same pull request — #1367 and #1370 were the
    // same upstream release split by `separateMajorMinor`.
    //
    // Kept OUT of `third-party images` above, and this is the one place #1550
    // did not consolidate. `separateMajorMinor: false` is what pairs the two
    // selenium images; applied to the whole image group it would also pair a
    // node MAJOR (22 -> 24, a rebuild of every frontend image) with a routine
    // postgres digest, which is the opposite of the "a held major must not stall
    // the routine stream" half of this issue. One group keeps its own identity
    // so the other can keep the split.
    {
      groupName: 'selenium images',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        '/^selenium//',
      ],
      separateMajorMinor: false,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Age the uv version pinned in [tool.uv].required-version and the build backend pinned in build-constraint-dependencies.',
      managerFilePatterns: [
        '/^src/backend/pyproject\\.toml$/',
        // The four side-service projects (#1374) pin the same uv EXACTly, so
        // they belong to the same `uv toolchain` pull request as the backend
        // pin, the workflow `uv==` lines and the Dockerfile image digest. A
        // pyproject missing from this list would age apart silently — that is
        // the #1296 class the group exists to prevent.
        '/^src/inference-service/pyproject\\.toml$/',
        '/^src/knowledge-service/pyproject\\.toml$/',
        '/^docker/embedding-service/pyproject\\.toml$/',
        '/^docker/reranker-service/pyproject\\.toml$/',
        // The two shared libraries (#1464) pin the same uv and were invisible
        // here for one review round: the pins landed in the pull request that
        // locked the libraries and this list was not widened with them, so the
        // NEXT `uv toolchain` bump would have moved five pins and left two
        // behind — and the tree guard that holds them equal
        // (test_library_lock_hash_verification.py) would have reddened the
        // required lane for a Renovate pull request that was doing exactly what
        // it was configured to do. `test_uv_pin_manager_covers_every_pin.py`
        // now holds this list to every pyproject that carries the pin.
        '/^src/libs/kp_vectordb/pyproject\\.toml$/',
        '/^src/libs/kp_errortracking/pyproject\\.toml$/',
      ],
      matchStrings: [
        'required-version = "==(?<currentValue>[0-9][^"]*)"',
        '"(?<depName>setuptools|wheel)==(?<currentValue>[0-9][^"]*)"',
      ],
      depNameTemplate: '{{#if depName}}{{depName}}{{else}}uv{{/if}}',
      datasourceTemplate: 'pypi',
      versioningTemplate: 'pep440',
    },
    {
      customType: 'regex',
      description: 'Update pinned versions in .github/renovate-pins.yaml — read by security workflows.',
      managerFilePatterns: [
        '/^\\.github/renovate-pins\\.yaml$/',
      ],
      matchStrings: [
        // A single version key under a bare `# datasource=… depName=…` comment.
        // Anchored on a `#` followed by `datasource` with nothing but optional
        // whitespace in between, so it does NOT also match the
        // `# renovate: datasource=…` form below. Were it to match both, the
        // nuclei template set would be extracted twice — once as a version-only
        // dependency, once as the digest pin — and Renovate would raise two
        // updates for the same thing.
        '#\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n[a-z0-9_]+:\\s*(?<currentValue>\\S+)',
        // A digest pin with its human-readable label on the NEXT line (#1543).
        // The digest is the operative value — the scan lanes fetch exactly it —
        // and the tag is prose, but both must move in one pull request, so one
        // match carries `currentDigest` AND `currentValue`. Same shape as the
        // `uses:` pins in this repository. Before it, the commit sat below
        // thirty lines of prose, matched no manager, and was moved by hand or
        // not at all — not at all in #1280 and #1454, repaired late in #1312.
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n[a-z0-9_]+:\\s*(?<currentDigest>[0-9a-f]{40})\\s*\\n[a-z0-9_]+:\\s*(?<currentValue>\\S+)',
      ],
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      // Without this, the pins introduced to make runs reproducible would simply
      // age out of sight — a stale pin and a floating reference fail the same
      // reproducibility goal from opposite directions.
      description: 'Update CI tool versions pinned inline in workflow run: steps.',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        // pip-style: 'pip-audit==2.10.1', 'pip-licenses==5.5.5'
        //
        // `uv` was an alternative here until #1383. It is gone because the thing
        // it matched is gone: no workflow carries a literal uv version any more
        // (`astral-sh/setup-uv` reads `[tool.uv].required-version` instead), and
        // tests/unit/guards/test_uv_pin_is_single.py fails the build if one comes
        // back. Keeping a dead alternative would have suggested a reintroduced
        // literal was still covered — it would be, but only until someone trusted
        // that and skipped the guard.
        "'(?<depName>pip-audit|pip-licenses)==(?<currentValue>[0-9][^']*)'",
        // npx-style: @stoplight/spectral-cli@6.16.2
        'npx --yes (?<depName>@[^@\\s]+/[^@\\s]+)@(?<currentValue>[0-9]\\S*)',
      ],
      datasourceTemplate: '{{#if (containsString depName "/")}}npm{{else}}pypi{{/if}}',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      // Container images referenced from a workflow `env:` value. The built-in
      // github-actions manager sees `uses:` and `container:`, not an image
      // string a step later passes to `docker run` — so without this the pin
      // would be immutable and unmaintained, which is the other half of the
      // reproducibility problem (#898).
      //
      // Captures tag AND digest, so Renovate bumps them together. A tag bumped
      // without its digest would leave the workflow silently on the old image.
      description: 'Update container images pinned in workflow env: values and in Taskfile vars.',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
        // `.taskfiles/checks.yaml` pins the renovate/renovate CLI that
        // `task renovate:dry-run` runs (#1383). Without this the pin would be
        // immutable and unmaintained — the same half of the reproducibility
        // problem the workflow env: pins were added for, and the shape #1177
        // records: a floating tool silently changes what a check MEANS.
        '/^\\.taskfiles/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        'renovate: datasource=docker depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z_]+:\\s*\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
