{
  extends: [
    'github>nolte/gh-plumbing//renovate-configs/common#v2.0.0',
    'helpers:pinGitHubActionDigests',
  ],
  mode: 'full',
  separateMajorMinor: true,
  separateMinorPatch: false,
  // Let the `pip-compile` manager own the backend locks explicitly. It reads the
  // pip-compile header of each requirements file, updates the constraints in the
  // referenced source (src/backend/pyproject.toml) and regenerates the lock in the
  // same PR (NFR-009 §6.1). If the inherited common preset pins `enabledManagers`
  // to an allowlist, `pip-compile` must also be present there for these rules to fire.
  'pip-compile': {
    managerFilePatterns: [
      '/^src/backend/requirements\\.txt$/',
      '/^src/backend/requirements-dev\\.txt$/',
    ],
  },
  // ── Helm dev values also carry a third-party pin (#1027) ─────────────────────
  // The built-in `helm-values` manager only matches `values.yaml` by default, so
  // `helm/kamerplanter/values-dev*.yaml` — which pin `timescale/timescaledb` for
  // the dev TimescaleDB StatefulSet — aged unattended: no version/CVE bumps ever
  // reached them (the defect #1027 records; found while doing #1024). Renovate
  // merges a manager's `managerFilePatterns` with its built-in default rather
  // than replacing it, so this ADDS the dev overrides to scope while `values.yaml`
  // stays covered by the default pattern (and by the #987/#1024 digest rule in
  // packageRules below). Widening also exposes the registry-less local Skaffold
  // image names (`kamerplanter-*`) those files reference, which Renovate cannot
  // resolve; the packageRule below disables them by pattern.
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)values-dev[^/]*\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      pinDigests: true,
    },
    // ── Kamerplanter's own images in the Helm chart (#987) ───────────────────
    // This rule IS the deploy mechanism, not a maintenance nicety. The chart
    // used to reference `ghcr.io/nolte/kamerplanter-*:latest`, and a deploy was
    // "publish, then restart the pods" — it worked only because the tag moved.
    // Rollback had nothing to name for the same reason, which is the defect
    // #987 records. The values now carry `latest@sha256:…`, so the reference no
    // longer moves and something has to move it: this rule. Publish -> Renovate
    // digest PR -> merge -> ArgoCD syncs. Rollback is `git revert` of that
    // commit.
    //
    // The rule above does NOT cover these, which is why this one exists and why
    // `arangodb` in the same file sits on an unpinned tag today: it matches
    // `matchCategories: ['docker']`, and Renovate's `helm-values` manager
    // declares `categories: ['helm','kubernetes']` with `pinDigests: false` in
    // its own defaultConfig. Matching by manager is the only thing that reaches
    // it. (Verified against the manager source, not inferred from behaviour.)
    //
    // Scoped to our own images on purpose. Third-party images in this chart
    // (arangodb, timescale/timescaledb) are upstream releases on immutable-by-
    // convention version tags that Renovate already ages; pinning their digests
    // too is a defensible separate decision, but it is not this one, and doing
    // it here would have hidden that behind a delivery change.
    //
    // grouped + automerge: one commit per deploy is what makes `git revert` a
    // rollback. Eight separate digest PRs would mean eight commits to revert
    // and a window where the components disagree about which build they are.
    {
      groupName: 'kamerplanter images',
      matchManagers: [
        'helm-values',
      ],
      matchPackageNames: [
        '/^ghcr\\.io/nolte/kamerplanter-/',
      ],
      pinDigests: true,
      automerge: true,
      // Ahead of the maintenance stream: config:base allows 2 PRs per hour, and
      // this one carries a deploy, not a dependency bump.
      prPriority: 10,
      labels: [
        'dependencies',
        'deployment',
      ],
      commitMessageTopic: 'the Kamerplanter images',
      commitMessageExtra: 'to the digest published from develop',
    },
    // ── Registry-less local Skaffold images in the dev values (#1027) ─────────
    // Widening `helm-values` to `values-dev*.yaml` (manager block above) also
    // exposes the local build artefacts those files reference —
    // `kamerplanter-knowledge`, `kamerplanter-knowledge-service`,
    // `kamerplanter-reranker-service`, `kamerplanter-embedding-service`,
    // `kamerplanter-vectordb`, `kamerplanter-inference-service`. Skaffold builds
    // these in-cluster; they have NO registry, so Renovate cannot look them up
    // and would only emit resolution failures. Disable them by PATTERN, not by
    // an enumerated list, so a new `kamerplanter-*` dev service is excluded
    // automatically instead of silently starting to fail on the next scan.
    //
    // Anchored on the bare name on purpose: the first-party images live under
    // `ghcr.io/nolte/kamerplanter-*` (base values.yaml, digest-pinned by the
    // rule above) and start with the registry host, so they are NOT matched by
    // `^kamerplanter-` and keep their digest-pinning behaviour. The one genuine
    // third-party pin in these files, `timescale/timescaledb`, is likewise not
    // matched and is now tracked for version/CVE bumps.
    {
      matchManagers: [
        'helm-values',
      ],
      matchPackageNames: [
        '/^kamerplanter-/',
      ],
      enabled: false,
    },
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      groupName: 'github-actions major',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    // ── Python backend dependency management (NFR-009 §6.1) ──────────────────
    // `src/backend/pyproject.toml` is the abstract single source of truth; the
    // `requirements*.txt` files are pip-compile locks. Renovate manages both with
    // the `pip-compile` manager, which bumps the constraint in pyproject.toml AND
    // recompiles the pinned (hash-locked) requirements files in a SINGLE PR, so the
    // source constraint and the lock always move together (closing the decorative-
    // lock drift surface behind PR #563). The default `pip_requirements` and
    // `pep621` managers are disabled for these backend files so the lock is not
    // scanned in isolation and the source is not double-managed — this also neutral-
    // ises any stray `pip_requirements` scan re-enabled by the inherited
    // `gh-plumbing//renovate-configs/common` preset (that preset is consumed via
    // `extends` above and could not be inspected offline; the explicit disable rule
    // below is evaluated last and wins).
    {
      matchManagers: [
        'pip_requirements',
        'pep621',
      ],
      matchFileNames: [
        'src/backend/**',
      ],
      enabled: false,
    },
    {
      groupName: 'python minor/patch',
      matchManagers: [
        'pip-compile',
      ],
      matchFileNames: [
        'src/backend/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '!starlette',
        '!fastapi',
        '!pydantic',
        '!pydantic-core',
      ],
    },
    {
      groupName: 'python fastapi-stack',
      matchManagers: [
        'pip-compile',
      ],
      matchFileNames: [
        'src/backend/**',
      ],
      matchPackageNames: [
        'fastapi',
        'starlette',
        'pydantic',
        'pydantic-core',
      ],
    },
    {
      groupName: 'python major',
      matchManagers: [
        'pip-compile',
      ],
      matchFileNames: [
        'src/backend/**',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    // ── jsdom held at 29 until Testing Library catches up (#827) ─────────────
    // jsdom 30 reimplemented its CSS engine, and the new `getComputedStyle`
    // return values make `@testing-library/dom`'s `isInaccessible()` classify
    // everything rendered into a MUI portal (Select menus, Autocomplete poppers,
    // dialogs) as inaccessible. Those elements then vanish from every role
    // query: 71 of 361 frontend test files went red on the 29 -> 30 bump (#824).
    //
    // This is an interaction between jsdom 30 and Testing Library, not a defect
    // in our components — the same components pass their E2E coverage in a real
    // browser. But there is nothing to bump *to*: `@testing-library/dom` is at
    // 10.4.1, published 2025-12-13, and that is exactly what is installed; the
    // upstream tracker carries no jsdom-30 issue. Rewriting the affected tests
    // off role queries would weaken them to enable a version bump, which the
    // issue explicitly rules out.
    //
    // So majors are held and minors/patches keep flowing. Revisit when
    // `@testing-library/dom` ships a release naming jsdom 30, then drop this
    // rule and let the bump run — do not simply raise the pin.
    {
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'jsdom',
        '@types/jsdom',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    // ── pip held below 26.2 until pip-tools catches up (#929) ───────────────
    // pip 26.2 removed `pip._internal.utils.compat.stdlib_pkgs`. pip-tools
    // imports it unconditionally via `piptools.sync`, which `pip-compile` pulls
    // in while validating its config — so `pip-compile` dies with an ImportError
    // before doing any work, and the `Lock staleness` gate in backend.yml fails
    // on every run.
    //
    // There is nothing to bump *to*: pip-tools 7.6.1 is the latest release and
    // is affected, as are 7.6.0 and 7.5.3. pip is therefore pinned explicitly
    // rather than merely upgraded — in `.github/pip-tools-requirements.txt`,
    // installed by `task deps:toolchain`, which backend.yml's `Lock staleness`
    // job reaches through `task deps:check`. (It used to live in a backend.yml
    // step called "Install pip-tools"; that step no longer exists, and a revisit
    // trigger that names a step no `grep` can find is a trigger nobody pulls.)
    // This rule stops Renovate from re-raising the bump that breaks the pin.
    //
    // Revisit when pip-tools ships a release that drops the `stdlib_pkgs`
    // import, then drop this rule and bump both together — pinning pip forever
    // is the other half of the reproducibility problem, not a resting state.
    {
      matchDatasources: [
        'pypi',
      ],
      matchPackageNames: [
        'pip',
      ],
      allowedVersions: '<26.2',
    },
    // ── The toolchain that compiles the backend locks (#1296) ───────────────
    // `.github/pip-tools-requirements.txt` pins pip, pip-tools AND their
    // transitive dependencies, because pip-compile's output — down to the header
    // comment it writes into each lock — is a function of that whole set, not of
    // pip-tools alone. The file deliberately sits OUTSIDE `src/backend/`: the
    // rule above disables `pip_requirements` there so the compiled locks are not
    // scanned in isolation, and the toolchain is not a lock, it is the thing that
    // produces one. Renovate picks it up through the built-in `pip_requirements`
    // manager, whose default file pattern already matches this name.
    //
    // Grouped into ONE pull request on purpose. These versions are only
    // meaningful together — a click bump beside its pip-tools, not ahead of it —
    // and a bump here may legitimately move both locks' header, which is a single
    // recompile to review, not five.
    //
    // Two entries of that file also appear in the compiled backend locks and are
    // held equal to them by hand: `click` and `packaging`. `task deps:toolchain`
    // installs into whatever environment is active, so a toolchain `packaging`
    // ahead of `packaging==` in src/backend/requirements.txt leaves a backend
    // virtualenv running an unlocked version of it. When this group's pull
    // request moves either of the two, check them against the locks — the
    // toolchain versions do not have to be the newest, only reproducible.
    {
      groupName: 'python lock toolchain',
      matchManagers: [
        'pip_requirements',
      ],
      matchFileNames: [
        '.github/pip-tools-requirements.txt',
      ],
    },
    // ── click held below 8.5 for the lock toolchain only (#1296) ─────────────
    // click 8.5.0 stopped reporting an untouched boolean flag's `Option.default`
    // as `False` (it is a sentinel now). pip-tools 7.6.1 rebuilds the
    // `pip-compile …` line in each lock's header by skipping options whose value
    // still equals their default, so that comparison stopped matching and
    // `--no-index` appeared in the header of both backend locks — a flag that was
    // never passed and that would make the recorded command not reproduce the
    // lock if anyone ran it. Every backend pull request and `develop` itself went
    // red on that one line.
    //
    // There is nothing to bump *to*: pip-tools 7.6.1 is the latest release, it
    // declares `click>=8` with no upper bound, and it is affected. So the cap
    // sits here rather than in the workflow, where it would age unwatched.
    //
    // Scoped to this ONE file on purpose. click is also a runtime dependency of
    // the backend (via celery) and is pinned in src/backend/requirements.txt; a
    // repository-wide cap would freeze that copy too and stop its security
    // updates, which is a far larger cost than a stale build tool.
    //
    // Revisit when pip-tools ships a release that reads the parameter source
    // instead of comparing against `Option.default`, then drop this rule and let
    // click and pip-tools move together — pinning click forever is the other half
    // of the reproducibility problem, not a resting state.
    {
      matchManagers: [
        'pip_requirements',
      ],
      matchFileNames: [
        '.github/pip-tools-requirements.txt',
      ],
      matchPackageNames: [
        'click',
      ],
      allowedVersions: '<8.5',
    },
    {
      groupName: 'frontend eslint',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        '/eslint/',
      ],
    },
    {
      groupName: 'frontend mui',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        '/^@mui//',
      ],
    },
    {
      groupName: 'frontend react',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'react',
        'react-dom',
        '@types/react',
        '@types/react-dom',
      ],
    },
    {
      groupName: 'frontend typescript',
      matchManagers: [
        'npm',
      ],
      matchPackageNames: [
        'typescript',
      ],
      // Hold TypeScript below 7.0 until typescript-eslint ships a release
      // supporting the native TS 7 compiler. Its peer range is currently
      // "typescript >=4.8.4 <6.1.0", so TS 7 fails `npm ci` (ERESOLVE) and
      // crashes eslint. tsc/vitest already pass under TS 7 (see PR #425).
      // Remove this cap once typescript-eslint declares TS 7 support.
      allowedVersions: '<7.0.0',
    },
    {
      groupName: 'frontend minor/patch',
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        '!/eslint/',
        '!/^@mui//',
        '!react',
        '!react-dom',
        '!@types/react',
        '!@types/react-dom',
        '!typescript',
      ],
    },
    {
      groupName: 'docker databases',
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'arangodb',
        'valkey/valkey',
        'timescale/timescaledb',
      ],
    },
    {
      groupName: 'docker selenium',
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        '/selenium/',
      ],
    },
    {
      groupName: 'helm charts',
      matchManagers: [
        'helmv3',
      ],
    },
    {
      groupName: 'nodejs',
      matchManagers: [
        'asdf',
      ],
      matchPackageNames: [
        'nodejs',
      ],
    },
    {
      groupName: 'security pinned versions',
      matchFileNames: [
        '.github/renovate-pins.yaml',
      ],
      labels: [
        'dependencies',
        'security',
      ],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update pinned versions in .github/renovate-pins.yaml — read by security workflows.',
      managerFilePatterns: [
        '/^\\.github/renovate-pins\\.yaml$/',
      ],
      matchStrings: [
        '#\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n[a-z0-9_]+:\\s*(?<currentValue>\\S+)',
      ],
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      // Without this, the pins introduced to make runs reproducible would simply
      // age out of sight — a stale pin and a floating reference fail the same
      // reproducibility goal from opposite directions.
      description: 'Update CI tool versions pinned inline in workflow run: steps.',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        // pip-style: 'pip-audit==2.10.1'
        "'(?<depName>pip-audit|pip-licenses|pip-tools|pip)==(?<currentValue>[0-9][^']*)'",
        // npx-style: @stoplight/spectral-cli@6.16.2
        'npx --yes (?<depName>@[^@\\s]+/[^@\\s]+)@(?<currentValue>[0-9]\\S*)',
      ],
      datasourceTemplate: '{{#if (containsString depName "/")}}npm{{else}}pypi{{/if}}',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      // Container images referenced from a workflow `env:` value. The built-in
      // github-actions manager sees `uses:` and `container:`, not an image
      // string a step later passes to `docker run` — so without this the pin
      // would be immutable and unmaintained, which is the other half of the
      // reproducibility problem (#898).
      //
      // Captures tag AND digest, so Renovate bumps them together. A tag bumped
      // without its digest would leave the workflow silently on the old image.
      description: 'Update container images pinned in workflow env: values.',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        'renovate: datasource=docker depName=(?<depName>\\S+)\\s*\\n\\s*[A-Z_]+:\\s*\\S+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
